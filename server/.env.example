# Copy this file to .env and fill in the values. Never commit .env.

# Required
ANTHROPIC_API_KEY=your_key_here
RESEND_API_KEY=your_key_here

# Paid plan: access codes, comma-separated. One per customer. Remove a code to switch it off.
ACCESS_CODES=

# Paid plan through Stripe. Leave empty to keep Stripe off.
# Use a restricted key (Stripe > Developers > API keys > Create restricted key) with only
# "Checkout Sessions: Read" and "Subscriptions: Read". It starts with rk_live_ (rk_test_ in test mode).
STRIPE_SECRET_KEY=
# Optional: only this price unlocks the plan. Set it if the same Stripe account sells other subscriptions.
# STRIPE_PRICE_ID=price_...

# Where plan requests from the app are emailed.
# With the default sender (onboarding@resend.dev) Resend only delivers to the address
# that owns the Resend account, so use that address here.
LEADS_RECIPIENT=

# Optional
# ALERT_RECIPIENT=            # who receives the demo stock alert
# ALERT_SENDER=MiKardex <alertas@yourdomain.com>   # needs a domain verified in Resend
# ALERT_CRON=0 8 * * *        # demo stock alert schedule; */5 * * * * for a live demo
# EXPOSE_SYSTEM_PROMPT=true  # lets the app show the AI instructions (also set SHOW_PROMPT in src/config.js)
# ALLOWED_ORIGINS=https://inventory-assistant-theta.vercel.app
# FREE_DAILY_QUESTIONS_PER_IP=10
# PLAN_DAILY_QUESTIONS=100
# GLOBAL_DAILY_QUESTIONS=200
# MAX_ITEMS_FOR_AI=800
# TRUST_PROXY=false           # only if the server is exposed without a proxy in front
