# Copy this file to .env and fill in the values. Never commit .env.

# Required
ANTHROPIC_API_KEY=your_key_here
RESEND_API_KEY=your_key_here

# Paid plan: access codes, comma-separated. One per customer. Remove a code to switch it off.
ACCESS_CODES=

# Paid plan through PayPal. Leave empty to keep PayPal off (the page then shows no pay button).
# Get both in developer.paypal.com > Apps & Credentials > Live > Create App.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Recommended: only this plan unlocks. It is the plan id in src/config.js (starts with P-).
PAYPAL_PLAN_ID=
# PAYPAL_ENV=sandbox         # only while testing with a sandbox app and a sandbox plan

# Accounts: sign in with an email and a 6-digit code, "My account" and the history of analyses.
# Leave these empty to keep accounts off (the page then works as before, without sign-in).
# 1. Create a project in supabase.com and run accounts.sql (this folder) in its SQL Editor.
# 2. Project Settings > API: copy the project URL and the SECRET key (sb_secret_... or the old
#    service_role key). Never the publishable/anon key, and never in the page or the repo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 3. The address sign-in codes are sent from. Its domain must be verified in resend.com > Domains;
#    onboarding@resend.dev will not do, it only delivers to the owner of the Resend account.
#    Example: AUTH_SENDER=MiKardex <acceso@mikardex.cl>
AUTH_SENDER=
# FREE_UPLOADS=3              # uploads an account gets without the plan (keep it equal to src/config.js)
# SIGN_IN_EMAILS_PER_DAY=80   # sign-in codes emailed per day in total (Resend's free plan sends 100 a day)
# ACCOUNTS_DEV=true           # only on your own computer, without Supabase: accounts live in memory
#                             # and the codes are printed in this server's log instead of emailed

# Where plan requests from the app are emailed, and the notice of each new account.
# With the default sender (onboarding@resend.dev) Resend only delivers to the address
# that owns the Resend account, so use that address here.
LEADS_RECIPIENT=

# Optional
# ALERT_RECIPIENT=            # who receives the demo stock alert
# ALERT_SENDER=MiKardex <alertas@yourdomain.com>   # needs a domain verified in Resend
# ALERT_CRON=0 8 * * *        # demo stock alert schedule; */5 * * * * for a live demo
# EXPOSE_SYSTEM_PROMPT=true  # lets the app show the AI instructions (also set SHOW_PROMPT in src/config.js)
# ALLOWED_ORIGINS=https://inventory-assistant-theta.vercel.app
# FREE_DAILY_QUESTIONS_PER_IP=10
# PLAN_DAILY_QUESTIONS=100
# GLOBAL_DAILY_QUESTIONS=200
# MAX_ITEMS_FOR_AI=800
# TRUST_PROXY=false           # only if the server is exposed without a proxy in front
# The limits "per network address" read the visitor's address from X-Forwarded-For, which on some
# hosts a visitor can write themselves. Name here a header only the host can set. On Render:
# CLIENT_IP_HEADER=cf-connecting-ip
